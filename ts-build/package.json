{
  "name": "typescript-decorator-demo",
  "version": "1.0.0",
  "scripts": {
    "x": "esbuild init.ts --bundle --outfile=dist/bundle.js",
    "watch": "esbuild init.ts --bundle --outfile=dist/bundle.js --watch",
    "y": "http-server .",
    "start": "nub run x && nub run y"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "typescript": "^5.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  }
}