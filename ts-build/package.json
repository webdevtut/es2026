{
  "name": "typescript-decorator-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "x": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --sourcemap",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --watch --sourcemap",
    "y": "http-server .",
    "dev": "nub run x && nub run y"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "typescript": "^5.8.0",
    "rxjs": "^8.0.0-alpha.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  }
}