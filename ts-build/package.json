{
  "name": "typescript-decorator-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --sourcemap --minify",
    "build:css": "esbuild src/ui/styles/global.css --minify --outfile=dist/jsalreadyknows.css",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --watch --sourcemap --minify",
    "y": "http-server .",
    "dev": "npm run build && npm run build:css && npm run y"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "prop-for-that": "^0.7.12",
    "rxjs": "^8.0.0-alpha.14",
    "typescript": "^7.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  }
}